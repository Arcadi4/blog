{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "SHELL=/bin/bash npx --yes get-pnpm@0.0.3 12.0.0-rc.7 && PATH=\"${PNPM_HOME:-$HOME/.local/share/pnpm}/bin:$PATH\" pnpm install --frozen-lockfile",
  "buildCommand": "export PNPM_HOME=\"${PNPM_HOME:-$HOME/.local/share/pnpm}\" && export PATH=\"$PNPM_HOME/bin:$PATH\" && pnpm build"
}
